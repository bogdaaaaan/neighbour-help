{
	"compilerOptions": {
		"target": "es2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2023"
		],
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
	},
	"include": [
		"src/**/*.ts"
	]
}